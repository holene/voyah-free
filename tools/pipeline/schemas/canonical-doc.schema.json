{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voyah-free.local/schemas/canonical-doc.schema.json",
  "title": "CanonicalDoc",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "doc_id",
    "title",
    "description",
    "lang",
    "sections",
    "warnings",
    "specs",
    "glossary_terms",
    "provenance"
  ],
  "properties": {
    "doc_id": { "type": "string" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "lang": { "type": "string", "enum": ["en", "no"] },
    "sections": {
      "type": "array",
      "items": { "$ref": "#/$defs/section" }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "specs": {
      "type": "array",
      "items": { "$ref": "#/$defs/specRow" }
    },
    "glossary_terms": {
      "type": "array",
      "items": { "type": "string" }
    },
    "provenance": {
      "type": "array",
      "items": { "$ref": "#/$defs/provenanceEntry" }
    }
  },
  "$defs": {
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "heading", "level", "body_md"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "heading": { "type": "string" },
        "level": { "type": "integer", "minimum": 1, "maximum": 6 },
        "body_md": { "type": "string" },
        "chunk_ids": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "specRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "value"],
      "properties": {
        "label": { "type": "string" },
        "value": { "type": "string" }
      }
    },
    "provenanceEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_pdf", "page_start", "page_end"],
      "properties": {
        "source_pdf": { "type": "string" },
        "page_start": { "type": "integer", "minimum": 1 },
        "page_end": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string" }
      }
    }
  }
}
