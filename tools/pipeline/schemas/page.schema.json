{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voyah-free.local/schemas/page.schema.json",
  "title": "ExtractedPage",
  "type": "object",
  "additionalProperties": false,
  "required": ["page_number", "width", "height", "blocks", "text_joined", "char_count"],
  "properties": {
    "page_number": { "type": "integer", "minimum": 1 },
    "width": { "type": "number" },
    "height": { "type": "number" },
    "blocks": {
      "type": "array",
      "items": { "$ref": "#/$defs/textBlock" }
    },
    "text_joined": { "type": "string" },
    "char_count": { "type": "integer", "minimum": 0 },
    "ocr_applied": { "type": "boolean" },
    "ocr_confidence_mean": { "type": ["number", "null"] }
  },
  "$defs": {
    "textBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "text", "bbox"],
      "properties": {
        "type": { "type": "string", "enum": ["text", "image"] },
        "text": { "type": "string" },
        "bbox": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "type": "number" }
        },
        "font_size": { "type": ["number", "null"] },
        "image_ref": { "type": ["string", "null"] }
      }
    }
  }
}
