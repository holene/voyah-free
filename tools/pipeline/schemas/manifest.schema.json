{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voyah-free.local/schemas/manifest.schema.json",
  "title": "PipelineManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "updated_at", "documents"],
  "properties": {
    "version": { "type": "string", "const": "1" },
    "updated_at": { "type": "string", "format": "date-time" },
    "documents": {
      "type": "array",
      "items": { "$ref": "#/$defs/documentIndexEntry" }
    }
  },
  "$defs": {
    "documentIndexEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["doc_id", "source_pdf_relpath", "sha256", "source_lang", "last_extracted_at"],
      "properties": {
        "doc_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "source_pdf_relpath": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "source_lang": { "type": "string", "enum": ["en", "no"] },
        "last_extracted_at": { "type": "string", "format": "date-time" },
        "ocr_used": { "type": "boolean" },
        "extractor_version": { "type": "string" }
      }
    }
  }
}
